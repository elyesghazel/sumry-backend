# Copy to .env next to docker-compose.yml and fill in the two secrets:
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 24)|; s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -base64 48 | tr -d '\n')|" .env

# --- Required ---
# Database password, hex so it is safe in a JDBC URL and shell.  openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs session tokens. Base64, at least 32 bytes.  openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=

# --- Address ---
# Public domain, e.g. sumry.example.com. Its DNS must point at this host and ports 80/443
# must be reachable; Caddy then gets a certificate on its own. Empty = plain HTTP on port 80.
SUMRY_DOMAIN=
# Host ports Caddy is published on.
SUMRY_HTTP_PORT=80
SUMRY_HTTPS_PORT=443
# Image tag for backend and frontend: latest, a release tag like v1.0.0, or sha-<commit>.
SUMRY_VERSION=latest

# --- Users ---
# First admin. On the first start with an empty database this user is created and a
# one-time password is printed once:  docker compose logs backend | grep "Bootstrap admin"
SUMRY_BOOTSTRAP_ADMIN_EMAIL=
# closed (default), invite or open.
SUMRY_REGISTRATION_MODE=closed
# Session length in milliseconds (default 24 h).
JWT_EXPIRATION_MS=86400000

# --- Optional ---
# Extra browser origins allowed to call /api, comma-separated. Not needed for the web app
# served by this stack, which is same-origin.
SUMRY_CORS_ALLOWED_ORIGINS=

# Monthly statement mail. Empty host = mail off.
SUMRY_MAIL_HOST=
SUMRY_MAIL_PORT=587
SUMRY_MAIL_USER=
SUMRY_MAIL_PASSWORD=
SUMRY_MAIL_FROM=
SUMRY_MAIL_AUTH=true
SUMRY_MAIL_STARTTLS=true
# Send last month's statement on the 1st.
SUMRY_STATEMENT_SCHEDULED=false

# Plan limits. Off: every user has every feature.
SUMRY_LIMITS_ENABLED=false
SUMRY_FREE_MAX_ACCOUNTS=2

# Claude check on statement imports through a host bridge. Off unless all three are set.
SUMRY_AI_BRIDGE_URL=
SUMRY_AI_BRIDGE_TOKEN=
SUMRY_AI_USERS=
